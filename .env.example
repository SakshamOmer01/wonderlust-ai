# Wonderlust environment configuration
# Copy to .env (never commit .env — it is gitignored).

# PostgreSQL connection string used by Prisma (required)
DATABASE_URL="postgresql://user:password@localhost:5432/wonderlust"

# Auth.js session signing secret (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical application URL — used by Auth.js for redirects (required in production)
AUTH_URL="http://localhost:3000"

# Optional: credentials created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@wonderlust.local"
SEED_ADMIN_PASSWORD="Wonderlust123!"
