generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  name                String?
  avatar              String?
  role                String               @default("user")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profileId           String?              @unique
  /// Incremented whenever credentials change, invalidating existing sessions.
  sessionVersion      Int                  @default(0)
  bookings            Booking[]
  passwordResetTokens PasswordResetToken[]
  profile             Profile?
  reviews             Review[]
  savedDestinations   SavedDestination[]
  sessions            Session[]
  trips               Trip[]
}

/// Single-use, expiring password reset tokens.
/// Only a SHA-256 hash of the token is stored, never the raw value.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Destination {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  country           String
  continent         String
  category          String
  image             String
  rating            Float
  reviewCount       Int                @default(0)
  summary           String
  bestTimeToVisit   String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reviews           Review[]
  savedDestinations SavedDestination[]
  trips             Trip[]
}

model Trip {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  destinationId   String
  destinationName String
  startDate       DateTime
  endDate         DateTime
  travelers       Int
  budget          String
  durationDays    Int
  image           String
  price           Float
  isFavorite      Boolean            @default(false)
  userId          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bookings        Booking[]
  budgetPlan      BudgetPlan?
  reviews         Review[]
  destination     Destination        @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id])
  tripAiPlan      TripAiPlan?
  itinerary       TripItinerary[]
  savedBy         SavedDestination[] @relation("SavedDestinationToTrip")

  @@index([destinationId])
  @@index([isFavorite])
  @@index([startDate])
  @@index([userId])
}

model TripItinerary {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  activity    String
  description String?
  startTime   String?
  endTime     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber], map: "TripItinerary_tripId_dayNumber_unique")
  @@index([tripId])
}

model SavedDestination {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips         Trip[]      @relation("SavedDestinationToTrip")

  @@unique([userId, destinationId])
  @@index([userId])
  @@index([destinationId])
}

model Booking {
  id          String    @id @default(cuid())
  userId      String
  tripId      String
  status      String    @default("pending")
  totalPrice  Float
  travelers   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([status])
}

model Review {
  id            String       @id @default(cuid())
  userId        String
  tripId        String?
  destinationId String?
  rating        Int          @default(5)
  comment       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  trip          Trip?        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@index([destinationId])
  @@index([tripId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Structured, validated JSON of the AI-generated itinerary and budget.
model TripAiPlan {
  id        String   @id @default(cuid())
  tripId    String   @unique
  contents  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model BudgetPlan {
  id             String   @id @default(cuid())
  tripId         String   @unique
  accommodation  Float    @default(0)
  food           Float    @default(0)
  transportation Float    @default(0)
  activity       Float    @default(0)
  other          Float    @default(0)
  total          Float    @default(0)
  remaining      Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model AiConfig {
  key       String   @id @default(cuid())
  model     String   @default("gpt-4o-mini")
  baseUrl   String   @default("https://api.openai.com/v1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conversation history for the AI travel assistant (server-side store).
model AiChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId])
}
